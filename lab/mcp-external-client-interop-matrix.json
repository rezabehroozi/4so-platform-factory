{
  "apiVersion": "platform.4so.io/v1alpha1",
  "kind": "MCPExternalClientInteropMatrix",
  "authority": "MCP_EXTERNAL_CLIENT_INTEROPERABILITY_MATRIX_V2",
  "spec": {
    "protocol": "2026-07-28",
    "transport": "streamable-http",
    "resourcePath": "/mcp",
    "sourceContractStatus": "implemented",
    "externalCertificationStatus": "pending",
    "blocker": "MCP_EXTERNAL_CLIENT_INTEROP_EVIDENCE_PENDING",
    "sharedRequiredChecks": [
      "oauth-protected-resource-discovery",
      "dedicated-audience-validation",
      "authorization-filtered-tools-list",
      "project-resource-scope-negative-control",
      "revoked-delegation-negative-control",
      "read-only-client-mutation-negative-control",
      "administration-approval-self-approval-negative-control"
    ],
    "clients": [
      {
        "id": "chatgpt",
        "displayName": "ChatGPT custom MCP",
        "sourceContract": "ready",
        "externalExecution": "pending"
      },
      {
        "id": "claude",
        "displayName": "Claude remote MCP",
        "sourceContract": "ready",
        "externalExecution": "pending"
      },
      {
        "id": "gemini",
        "displayName": "Gemini remote MCP",
        "sourceContract": "ready",
        "externalExecution": "pending"
      },
      {
        "id": "grok",
        "displayName": "Grok custom MCP",
        "sourceContract": "ready",
        "externalExecution": "pending"
      }
    ],
    "localBlackBoxHarness": "python3 scripts/mcp_external_client_certify.py --endpoint <api>/mcp --token <scoped-mcp-read-token>",
    "truthRule": "Passing the baseline local black-box harness proves only the checks named in baselineHarnessChecks. Named-client certification additionally requires one MCP_EXTERNAL_CLIENT_INTEROP_CAMPAIGN_V1, per-client replay challenges, real credentialed external execution receipts from ChatGPT, Claude, Gemini and Grok with unique providerExecutionRef provenance, and MCP_EXTERNAL_SERVER_AUDIT_WITNESS_V1 coverage for all six protected-request checks per client. No local harness, copied receipt, or self-declared receipt can claim named-client certification.",
    "baselineHarnessChecks": [
      "oauth-protected-resource-discovery",
      "authorization-filtered-tools-list",
      "read-only-client-mutation-negative-control"
    ],
    "fixtureBoundHarnessChecks": [
      "project-resource-scope-negative-control"
    ],
    "credentialedExternalChecks": [
      "dedicated-audience-validation",
      "revoked-delegation-negative-control",
      "administration-approval-self-approval-negative-control"
    ],
    "campaignAuthority": "MCP_EXTERNAL_CLIENT_INTEROP_CAMPAIGN_V1",
    "campaignPreparation": "python3 scripts/prepare_mcp_external_interop_campaign.py --endpoint https://<api>/mcp --out /secure/campaign.json",
    "sealCommand": "python3 scripts/seal_mcp_external_interop.py --campaign /secure/campaign.json --receipts /secure/receipts --audits /secure/audits --out /secure/evidence.json",
    "serverAuditWitnessAuthority": "MCP_EXTERNAL_SERVER_AUDIT_WITNESS_V1",
    "serverAuditWitnessedChecks": [
      "dedicated-audience-validation",
      "authorization-filtered-tools-list",
      "project-resource-scope-negative-control",
      "revoked-delegation-negative-control",
      "read-only-client-mutation-negative-control",
      "administration-approval-self-approval-negative-control"
    ],
    "auditFetchCommand": "C7W_PLATFORM_ADMIN_TOKEN=<secret> python3 scripts/fetch_mcp_external_audit_window.py --campaign /secure/campaign.json --receipt /secure/receipts/<client>.json --client <client> --out /secure/audits/<client>.json",
    "receiptAdmissionCommand": "python3 scripts/admit_mcp_external_receipt.py --campaign /secure/campaign.json --receipt /secure/receipts/<client>.json --audit /secure/audits/<client>.json --client <client> --progress lab/mcp-external-client-interop-progress.json",
    "finalReleaseSealCommand": "python3 scripts/seal_final_exact_release.py --root . --out lab/final-exact-release-evidence.json"
  }
}
