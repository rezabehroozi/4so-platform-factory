{
  "apiVersion": "platform.4so.io/v1alpha1",
  "kind": "MCPExternalClientInteropMatrix",
  "authority": "MCP_EXTERNAL_CLIENT_INTEROPERABILITY_MATRIX_V2",
  "spec": {
    "protocol": "2026-07-28",
    "transport": "streamable-http",
    "resourcePath": "/mcp",
    "sourceContractStatus": "implemented",
    "externalCertificationStatus": "pending",
    "blocker": "MCP_EXTERNAL_CLIENT_INTEROP_EVIDENCE_PENDING",
    "sharedRequiredChecks": [
      "oauth-protected-resource-discovery",
      "dedicated-audience-validation",
      "authorization-filtered-tools-list",
      "project-resource-scope-negative-control",
      "revoked-delegation-negative-control",
      "read-only-client-mutation-negative-control",
      "administration-approval-self-approval-negative-control"
    ],
    "clients": [
      {
        "id": "chatgpt",
        "displayName": "ChatGPT custom MCP",
        "sourceContract": "ready",
        "externalExecution": "pending"
      },
      {
        "id": "claude",
        "displayName": "Claude remote MCP",
        "sourceContract": "ready",
        "externalExecution": "pending"
      },
      {
        "id": "gemini",
        "displayName": "Gemini remote MCP",
        "sourceContract": "ready",
        "externalExecution": "pending"
      },
      {
        "id": "grok",
        "displayName": "Grok custom MCP",
        "sourceContract": "ready",
        "externalExecution": "pending"
      }
    ],
    "localBlackBoxHarness": "python3 scripts/mcp_external_client_certify.py --endpoint <api>/mcp --token <scoped-mcp-read-token>",
    "truthRule": "Passing the baseline local black-box harness proves only the checks named in baselineHarnessChecks. Named-client certification additionally requires one unexpired MCP_EXTERNAL_CLIENT_INTEROP_CAMPAIGN_V1 whose four OAuth client IDs are read back as ACTIVE provider-matched entries from the Product trusted-client registry, per-client replay challenges, real credentialed external execution receipts from ChatGPT, Claude, Gemini and Grok with unique providerExecutionRef provenance and executedAt inside the campaign window, and MCP_EXTERNAL_SERVER_AUDIT_WITNESS_V1 coverage for all six protected-request checks per client inside the bounded execution audit window. Five authenticated protected checks must carry the exact Product-trusted oauthClientId in immutable server audit; the wrong-audience authentication denial must not infer client identity from rejected claims. No expired campaign, stale audit window, local harness, copied receipt, or self-declared receipt can claim named-client certification.",
    "baselineHarnessChecks": [
      "oauth-protected-resource-discovery",
      "authorization-filtered-tools-list",
      "read-only-client-mutation-negative-control"
    ],
    "fixtureBoundHarnessChecks": [
      "project-resource-scope-negative-control"
    ],
    "credentialedExternalChecks": [
      "dedicated-audience-validation",
      "revoked-delegation-negative-control",
      "administration-approval-self-approval-negative-control"
    ],
    "campaignAuthority": "MCP_EXTERNAL_CLIENT_INTEROP_CAMPAIGN_V1",
    "campaignPreparation": "<python> scripts/run_mcp_external_interop.py --state-dir <state-dir> prepare --endpoint <https-mcp-endpoint> --oauth-client-map <private-oauth-client-bindings.json>",
    "sealCommand": "<python> scripts/run_mcp_external_interop.py --state-dir <state-dir> seal",
    "serverAuditWitnessAuthority": "MCP_EXTERNAL_SERVER_AUDIT_WITNESS_V1",
    "serverAuditWitnessedChecks": [
      "dedicated-audience-validation",
      "authorization-filtered-tools-list",
      "project-resource-scope-negative-control",
      "revoked-delegation-negative-control",
      "read-only-client-mutation-negative-control",
      "administration-approval-self-approval-negative-control"
    ],
    "auditTokenSource": "environment:C7W_PLATFORM_ADMIN_TOKEN",
    "auditFetchCommand": "integrated: local runner admit -> scripts/fetch_mcp_external_audit_window.py",
    "receiptAdmissionCommand": "<python> scripts/run_mcp_external_interop.py --state-dir <state-dir> admit --client <client> --capture <state-dir>/captures/<client>.capture.json",
    "finalReleaseSealCommand": "<python> scripts/seal_final_exact_release.py --root . --out lab/final-exact-release-evidence.json",
    "oauthClientBindingAuthority": "MCP_EXTERNAL_CLIENT_OAUTH_BINDINGS_V1",
    "oauthClientMapSchema": {
      "authority": "MCP_EXTERNAL_CLIENT_OAUTH_BINDINGS_V1",
      "clients": {
        "chatgpt": "<registered-client-id>",
        "claude": "<registered-client-id>",
        "gemini": "<registered-client-id>",
        "grok": "<registered-client-id>"
      }
    },
    "trustedClientRegistryEndpoint": "GET /api/v1/mcp/trusted-clients",
    "campaignMaxAgeSeconds": 604800,
    "executionAuditWindowSeconds": 7200,
    "executionRunnerAuthority": "MCP_EXTERNAL_LOCAL_EXECUTION_RUNNER_V1",
    "statusCommand": "<python> scripts/run_mcp_external_interop.py --state-dir <state-dir> status"
  }
}
