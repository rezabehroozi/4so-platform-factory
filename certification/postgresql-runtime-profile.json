{
  "schemaVersion": 1,
  "profile": "postgresql-authority-runtime",
  "supportedMajors": [
    16,
    17,
    18
  ],
  "minimumSecureMinor": {
    "16": "16.15",
    "17": "17.11",
    "18": "18.6"
  },
  "requiredClientTools": [
    "psql",
    "pg_dump",
    "pg_restore",
    "createdb",
    "dropdb"
  ],
  "mandatoryChecks": [
    "prerequisites",
    "security-baseline",
    "server-version",
    "tls-policy",
    "migration-fresh",
    "migration-replay",
    "schema-invariants",
    "atomic-resource-audit-outbox",
    "optimistic-revision-contention",
    "idempotency-contention",
    "lease-fencing-contention",
    "outbox-skip-locked-contention",
    "append-only-audit",
    "immutable-evidence",
    "postgres-restart",
    "backup-restore",
    "post-restore-invariants",
    "cleanup"
  ],
  "certificationRules": {
    "allMandatoryChecksMustPass": true,
    "blockedIsNotPass": true,
    "skippedIsNotPass": true,
    "evidenceMustBeSealed": true,
    "destructiveTestDatabaseRequired": true,
    "runtimeCertificateExpiresDays": 90
  },
  "requiredTLSMode": "verify-full",
  "securityBaselinePublishedAt": "2026-08-13",
  "securityBaselineMaxAgeDays": 90,
  "securityBaselineSource": "https://www.postgresql.org/about/news/postgresql-186-1711-1615-1519-1424-and-19-beta-3-released-3365/"
}
