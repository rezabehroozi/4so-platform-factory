{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.4so.io/schemas/lab-execution.schema.json",
  "title": "4SO Platform Factory Lab Execution",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "platform.4so.io/v1alpha1"},
    "kind": {"const": "LabExecution"},
    "metadata": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": {"name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"}}
    },
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["releaseArtifact", "serverTier", "ssh", "servers"],
      "properties": {
        "releaseArtifact": {"type": "string", "minLength": 1},
        "serverTier": {"enum": ["current-import-minimum", "production-ha", "day2-replacement", "full-multicluster"]},
        "bundleDirectory": {"type": "string", "minLength": 1},
        "ssh": {
          "type": "object", "additionalProperties": false, "required": ["identityFile", "knownHostsFile"],
          "properties": {
            "user": {"const": "root", "default": "root"},
            "identityFile": {"type": "string", "minLength": 1},
            "knownHostsFile": {"type": "string", "minLength": 1}
          }
        },
        "servers": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["role", "host"],
            "properties": {"role": {"type": "string", "minLength": 1}, "host": {"type": "string", "minLength": 1}}
          }
        },
        "management": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "publicEndpoint": {"type": "string", "pattern": "^https://"},
            "dnsZone": {"type": "string"},
            "storageClass": {"type": "string"},
            "objectStorage": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "url": {"type": "string", "pattern": "^https://"},
                "bucket": {"type": "string"},
                "prefix": {"type": "string"},
                "region": {"type": "string"},
                "credentialRef": {"type": "string", "pattern": "^external-secret://"}
              }
            }
          }
        },
        "ai": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "provider": {"enum": ["none", "codex-cli", "claude-code", "openai-responses", "openai-compatible-chat", "antigravity-command"]},
            "model": {"type": "string"},
            "endpoint": {"type": "string"},
            "apiKeyEnv": {"type": "string", "default": "PLATFORM_FACTORY_AI_API_KEY"},
            "maxOutputTokens": {"type": "integer", "minimum": 100, "maximum": 1200},
            "maxTurns": {"type": "integer", "minimum": 1, "maximum": 4},
            "maxBudgetUSD": {"type": "number", "minimum": 0, "maximum": 20},
            "command": {"type": "string"}
          }
        }
      }
    }
  }
}
