{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.4so.io/schemas/service-account.schema.json",
  "title": "Scoped Service Account",
  "type": "object",
  "additionalProperties": false,
  "required": ["organizationId", "name", "displayName", "productRole"],
  "properties": {
    "organizationId": {"type": "string", "minLength": 1},
    "projectId": {"type": "string", "minLength": 1},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
    "displayName": {"type": "string", "minLength": 1, "maxLength": 120},
    "productRole": {"enum": ["platform-viewer", "platform-operator"]}
  }
}
