{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://4so.local/schemas/component-upgrade-source-admission.schema.json",
  "type": "object",
  "required": ["apiVersion", "kind", "authority", "schemaVersion", "policy", "components"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {"const": "platform.4so.io/v1alpha1"},
    "kind": {"const": "ComponentUpgradeSourceAdmission"},
    "authority": {"const": "COMPONENT_UPGRADE_SOURCE_ADMISSION_V1"},
    "schemaVersion": {"const": 1},
    "policy": {"type": "object"},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["component", "targetRelease", "status", "previousVersion", "source", "rationale", "reviewEvidence"],
        "additionalProperties": false,
        "properties": {
          "component": {"type": "string", "minLength": 1},
          "targetRelease": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "status": {"enum": ["review-required", "admitted-for-acquisition", "install-only-first-product-release"]},
          "previousVersion": {"type": "string"},
          "source": {"type": "string"},
          "rationale": {"type": "string", "minLength": 1},
          "reviewEvidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "reference", "summary"],
              "additionalProperties": false,
              "properties": {
                "kind": {"enum": ["upstream-release-history", "product-release-history"]},
                "reference": {"type": "string", "minLength": 1},
                "summary": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
