{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.4so.io/schemas/field-execution-campaign.schema.json",
  "title": "4SO Platform Factory Field Execution Campaign",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "schemaVersion", "id", "installerUrl", "request", "requestDigest", "bundleDigest", "planId", "preflightDigest", "executionEnabled", "state", "evidenceVerified", "createdAt", "updatedAt", "events", "integrityDigest"],
  "properties": {
    "apiVersion": {"const": "platform.4so.io/v1alpha1"},
    "kind": {"const": "FieldExecutionCampaign"},
    "schemaVersion": {"enum": [1, 2, 3]},
    "id": {"type": "string", "minLength": 1},
    "installerUrl": {"type": "string", "format": "uri"},
    "request": {"type": "object"},
    "requestDigest": {"$ref": "#/$defs/digest"},
    "bundleDigest": {"$ref": "#/$defs/digest"},
    "releaseArtifactDigest": {"$ref": "#/$defs/digest"},
    "installerBinaryDigest": {"$ref": "#/$defs/digest"},
    "planId": {"type": "string", "minLength": 1},
    "preflightDigest": {"$ref": "#/$defs/digest"},
    "executionEnabled": {"type": "boolean"},
    "state": {"enum": ["PREPARED", "START_REQUESTED", "RUNNING", "FAILED", "SUCCEEDED"]},
    "runId": {"type": "string"},
    "runState": {"type": "string"},
    "simulation": {"type": "boolean"},
    "lastError": {"type": "string"},
    "evidenceVerified": {"type": "boolean"},
    "evidenceReportId": {"type": "string"},
    "evidenceDigest": {"$ref": "#/$defs/digest"},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "events": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "integrityDigest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"properties": {"schemaVersion": {"const": 3}}},
      "then": {"required": ["releaseArtifactDigest", "installerBinaryDigest"]}
    },
    {
      "if": {"properties": {"schemaVersion": {"const": 2}}},
      "then": {
        "required": ["releaseArtifactDigest"],
        "not": {"required": ["installerBinaryDigest"]}
      }
    },
    {
      "if": {"properties": {"schemaVersion": {"const": 1}}},
      "then": {
        "not": {
          "anyOf": [
            {"required": ["releaseArtifactDigest"]},
            {"required": ["installerBinaryDigest"]}
          ]
        }
      }
    }
  ],
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}
