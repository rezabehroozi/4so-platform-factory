{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.4so.io/schemas/management-workload-manifest-image-resolution.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authority",
    "schemaVersion",
    "sourceManifestSha256",
    "sourceManifestBytes",
    "resolvedManifestSha256",
    "resolvedManifestBytes",
    "images"
  ],
  "properties": {
    "authority": {"const": "MANAGEMENT_WORKLOAD_MANIFEST_IMAGE_RESOLUTION_V1"},
    "schemaVersion": {"const": 1},
    "sourceManifestSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sourceManifestBytes": {"type": "integer", "minimum": 1, "maximum": 33554432},
    "resolvedManifestSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "resolvedManifestBytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
    "images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "exact"],
        "properties": {
          "source": {"type": "string", "minLength": 1, "maxLength": 1024},
          "exact": {"type": "string", "pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$", "maxLength": 1024}
        }
      }
    }
  }
}
