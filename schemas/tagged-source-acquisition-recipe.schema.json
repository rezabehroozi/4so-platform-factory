{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://platform.4so.io/schemas/tagged-source-acquisition-recipe.schema.json",
  "type":"object","additionalProperties":false,
  "required":["apiVersion","kind","metadata","spec"],
  "properties":{
    "apiVersion":{"const":"platform.4so.io/v1alpha1"},
    "kind":{"const":"TaggedSourceAcquisitionRecipe"},
    "metadata":{"type":"object","additionalProperties":false,"required":["component","version"],"properties":{"component":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{0,62}$"},"version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"}}},
    "spec":{"type":"object","additionalProperties":false,"required":["authority","repository","tag","commitSHA","releaseURL","channel","licenseSPDX","licenseFile","files"],"properties":{
      "authority":{"const":"TAGGED_SOURCE_ACQUISITION_RECIPE_V1"},
      "repository":{"type":"string","pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
      "tag":{"type":"string","pattern":"^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
      "commitSHA":{"type":"string","pattern":"^[0-9a-f]{40}$"},
      "releaseURL":{"type":"string","pattern":"^https://github\\.com/[^/]+/[^/]+/releases/tag/v[0-9]+\\.[0-9]+\\.[0-9]+$"},
      "channel":{"type":"string","minLength":1,"maxLength":64},
      "licenseSPDX":{"type":"string","minLength":1,"maxLength":128},
      "licenseFile":{"type":"string","pattern":"^[A-Za-z0-9_.-]+$"},
      "files":{"type":"array","minItems":1,"maxItems":128,"items":{"type":"object","additionalProperties":false,"required":["sourcePath","archivePath","render"],"properties":{"sourcePath":{"type":"string","minLength":1,"maxLength":512},"archivePath":{"type":"string","pattern":"^[A-Za-z0-9_.-]+$"},"render":{"type":"boolean"}}}}
    }}
  }
}
