{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.4so.io/schemas/supply-chain-handoff-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "platform.4so.io/v1alpha1"
    },
    "kind": {
      "const": "SupplyChainHandoffPlan"
    },
    "metadata": {
      "type": "object"
    },
    "spec": {
      "type": "object",
      "required": [
        "authority",
        "schemaVersion",
        "releaseVersion",
        "truthModel",
        "componentAcquisition",
        "managementWorkloads",
        "releaseToolchain",
        "runtimeDependencyTransition",
        "historicalComponentAcquisition",
        "componentUpgradeSourceAdmission",
        "componentUpgradePairRequirements",
        "openBlockers"
      ],
      "properties": {
        "authority": {
          "const": "SUPPLY_CHAIN_HANDOFF_V1"
        },
        "schemaVersion": {
          "const": 1
        },
        "releaseVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "truthModel": {
          "type": "object",
          "required": [
            "derivedEvidenceOnly",
            "canonicalAuthorities",
            "stagingNeverPromotesSourceResolution",
            "stagingNeverPromotesRuntimeCertification",
            "physicalPassInferenceForbidden"
          ],
          "properties": {
            "derivedEvidenceOnly": {
              "const": true
            },
            "stagingNeverPromotesSourceResolution": {
              "const": true
            },
            "stagingNeverPromotesRuntimeCertification": {
              "const": true
            },
            "physicalPassInferenceForbidden": {
              "const": true
            }
          }
        },
        "componentAcquisition": {
          "type": "object"
        },
        "managementWorkloads": {
          "type": "object"
        },
        "releaseToolchain": {
          "type": "object"
        },
        "componentUpgradePairRequirements": {
          "type": "array",
          "minItems": 20
        },
        "openBlockers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "componentUpgradeSourceAdmission": {
          "type": "object",
          "required": [
            "authority",
            "admitted",
            "reviewRequired",
            "installOnlyFirstProductRelease"
          ],
          "properties": {
            "authority": {
              "const": "COMPONENT_UPGRADE_SOURCE_ADMISSION_V1"
            },
            "admitted": {
              "type": "array"
            },
            "reviewRequired": {
              "type": "array"
            },
            "installOnlyFirstProductRelease": {
              "type": "array"
            }
          }
        },
        "runtimeDependencyTransition": {
          "type": "object",
          "required": [
            "authority",
            "status",
            "gatewayTargetRelease",
            "kgatewayTargetRelease",
            "ciliumTargetRelease"
          ],
          "properties": {
            "authority": {
              "const": "RUNTIME_DEPENDENCY_TRANSITION_V1"
            },
            "status": {
              "enum": [
                "acquisition-pending",
                "runtime-certification-pending",
                "complete"
              ]
            },
            "gatewayTargetRelease": {
              "type": "string"
            },
            "kgatewayTargetRelease": {
              "type": "string"
            },
            "ciliumTargetRelease": {
              "type": "string"
            }
          }
        },
        "historicalComponentAcquisition": {
          "type": "object",
          "required": [
            "authority",
            "stageManifestPath",
            "helmReady",
            "taggedSourceSetReady",
            "waitingCurrentSource",
            "alreadyHistoricalSourceLocked",
            "installOnlyFirstProductRelease"
          ],
          "properties": {
            "authority": {
              "const": "HISTORICAL_UPGRADE_STAGED_BATCH_V1"
            },
            "stageManifestPath": {
              "const": "historical/stage-manifest.json"
            },
            "helmReady": {
              "type": "array"
            },
            "taggedSourceSetReady": {
              "type": "array"
            },
            "waitingCurrentSource": {
              "type": "array"
            },
            "alreadyHistoricalSourceLocked": {
              "type": "array"
            },
            "installOnlyFirstProductRelease": {
              "type": "array"
            }
          }
        }
      }
    }
  }
}
