{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.4so.io/schemas/installer-remote-bootstrap.schema.json",
  "title": "4SO Platform Factory Remote Installer Bootstrap",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "platform.4so.io/v1alpha1"},
    "kind": {"const": "InstallerRemoteBootstrap"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "platformctlBinary", "deploymentSpec"],
      "properties": {
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "user", "identityFile", "knownHostsFile"],
          "properties": {
            "host": {"type": "string", "minLength": 1, "maxLength": 253},
            "user": {"const": "root"},
            "identityFile": {"type": "string", "minLength": 1},
            "knownHostsFile": {"type": "string", "minLength": 1},
            "root": {"type": "string", "default": "/"}
          }
        },
        "platformctlBinary": {"type": "string", "minLength": 1},
        "deploymentSpec": {"type": "string", "minLength": 1}
      }
    }
  }
}
