{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.4so.io/schemas/installer-host-deployment.schema.json",
  "title": "Installer Host Deployment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "platform.4so.io/v1alpha1"
    },
    "kind": {
      "const": "InstallerHostDeployment"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installerBinary",
        "bundleDirectory",
        "listen",
        "executionEnabled",
        "allowInsecureHttp",
        "tls",
        "health",
        "service",
        "admission"
      ],
      "properties": {
        "installerBinary": {
          "type": "string",
          "minLength": 1
        },
        "bundleDirectory": {
          "type": "string",
          "minLength": 1
        },
        "listen": {
          "type": "string",
          "minLength": 3
        },
        "executionEnabled": {
          "type": "boolean"
        },
        "allowInsecureHttp": {
          "const": false
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "certificateFile": {
              "type": "string"
            },
            "privateKeyFile": {
              "type": "string"
            }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enable",
            "start"
          ],
          "properties": {
            "enable": {
              "type": "boolean"
            },
            "start": {
              "type": "boolean"
            }
          }
        },
        "health": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "timeoutSeconds",
            "intervalMilliseconds"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/[^?#]*$",
              "minLength": 1
            },
            "serverName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[^/:@]+$"
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            },
            "intervalMilliseconds": {
              "type": "integer",
              "minimum": 100,
              "maximum": 5000
            }
          }
        },
        "admission": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowDowngrade"
          ],
          "properties": {
            "allowDowngrade": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
