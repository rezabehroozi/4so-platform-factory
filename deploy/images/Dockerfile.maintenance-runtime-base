ARG AWS_CLI_IMAGE
ARG POSTGRES_RUNTIME_IMAGE
FROM ${AWS_CLI_IMAGE} AS awscli

FROM ${POSTGRES_RUNTIME_IMAGE}

# Compose the maintenance toolset from exact pre-acquired image authorities.
# No package manager or network fetch is permitted in this build.
COPY --from=awscli /usr/local/aws-cli/ /usr/local/aws-cli/
ENV PATH="/usr/local/aws-cli/v2/current/bin:${PATH}"

USER 65532:65532
ENTRYPOINT ["/bin/sh"]
