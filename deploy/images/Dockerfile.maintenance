ARG MAINTENANCE_RUNTIME_IMAGE
FROM ${MAINTENANCE_RUNTIME_IMAGE}
ARG SOURCE_RELEASE_DIGEST
LABEL platform.4so.io/product-role="maintenance" \
      platform.4so.io/source-release-digest="${SOURCE_RELEASE_DIGEST}"
# The maintenance runtime MUST already contain the complete exact toolset used by
# disaster-recovery and lifecycle jobs. This release recipe performs no network
# package installation; compatibility is certified before the image is admitted.
USER 65532:65532
ENTRYPOINT ["/bin/sh"]
