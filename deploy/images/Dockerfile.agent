ARG GO_BUILD_IMAGE
ARG RUNTIME_IMAGE
ARG SOURCE_COMMIT
FROM ${GO_BUILD_IMAGE} AS build
ARG SOURCE_COMMIT
WORKDIR /src
COPY . .
RUN VERSION="$(cat VERSION)" && test -n "$VERSION" && printf '%s' "$SOURCE_COMMIT" | grep -Eq '^[0-9a-f]{40}$' && \
    CGO_ENABLED=0 go test ./cmd/platform-agent && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -buildid= -X platform.4so.io/factory/internal/buildinfo.Version=$VERSION -X platform.4so.io/factory/internal/buildinfo.SourceCommit=$SOURCE_COMMIT" -o /out/platform-agent ./cmd/platform-agent
FROM ${RUNTIME_IMAGE}
COPY --from=build /out/platform-agent /platform-agent
USER nonroot:nonroot
ENTRYPOINT ["/platform-agent"]
