# Safe default: bind only to the local host. Place a TLS reverse proxy in front,
# or configure the built-in TLS certificate/key variables below.
PLATFORM_INSTALLER_LISTEN=127.0.0.1:9080
PLATFORM_INSTALLER_BUNDLE_DIR=/opt/4so-platform-factory/bundle
PLATFORM_INSTALLER_STATE_DIR=/var/lib/4so-platform-installer
PLATFORM_INSTALLER_ALLOW_EXECUTION=false
PLATFORM_INSTALLER_ALLOW_INSECURE_HTTP=false

# Direct HTTPS example:
# PLATFORM_INSTALLER_LISTEN=0.0.0.0:9443
# PLATFORM_INSTALLER_TLS_CERT_FILE=/etc/4so-platform-factory/tls/installer.crt
# PLATFORM_INSTALLER_TLS_KEY_FILE=/etc/4so-platform-factory/tls/installer.key

# Omit this value to generate /var/lib/4so-platform-installer/bootstrap-token
# with mode 0600. The token is never printed in logs.
# PLATFORM_INSTALLER_BOOTSTRAP_TOKEN=<strong-random-token>
