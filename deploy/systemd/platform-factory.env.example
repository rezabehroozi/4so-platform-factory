# Runtime authority is mandatory. Keep the real file mode 0600 and do not commit secrets.
# PostgreSQL is the production control-plane Source of Truth.
PLATFORM_FACTORY_POSTGRES_DSN=postgresql://platform_factory:CHANGE_ME@127.0.0.1:5432/platform_factory?sslmode=require

# Optional runtime endpoints. Prefer digest-pinned images where applicable.
# PLATFORM_FACTORY_INTERNAL_GIT_URL=http://platform-forgejo.platform-system.svc.cluster.local:3000
# PLATFORM_FACTORY_INTERNAL_REGISTRY_URL=http://127.0.0.1:5000
# PLATFORM_FACTORY_PUBLIC_URL=https://platform.example.com

# PostgreSQL-backed runtime requires explicit identity and signing configuration.
PLATFORM_FACTORY_OIDC_ENABLED=true
PLATFORM_FACTORY_OIDC_ISSUER=https://auth.example.com/realms/platform
PLATFORM_FACTORY_OIDC_INTERNAL_BASE=https://auth.example.com
PLATFORM_FACTORY_OIDC_CLIENT_ID=platform-console
PLATFORM_FACTORY_OIDC_REDIRECT_URL=https://platform.example.com/auth/callback
PLATFORM_FACTORY_SESSION_SECRET=CHANGE_ME_RANDOM_SESSION_SECRET
PLATFORM_FACTORY_CATALOG_SIGNING_PRIVATE_KEY_B64=CHANGE_ME_BASE64_ED25519_SEED
