  "kind": "ComponentRuntimeUpgradeMatrix",
  "authority": "COMPONENT_RUNTIME_UPGRADE_MATRIX_V2",
  "schemaVersion": 1,
  "policy": {
    "sourcePairRequiredForUpgradeRequiredComponents": true,
    "firstProductReleaseInstallOnlyAllowed": true,
    "historicalVersionFabricationForbidden": true,
    "distinctSourceLockDigestsRequired": true,
    "mutableTagResolutionForbidden": true,
    "exactVersionDirectionRequired": true,
    "sourceLockSelfIdentityRequired": true,
    "downgradeAdmission": "forbidden-by-default",
    "rollbackMeaning": "recovery-evidence-only; no fake rollback promise",
    "stages": [
      "preflight",
      "upgrade",
      "readiness",
      "failure-recovery",
      "remove-old-version"
    ],
    "certificationRule": "source-pair admission does not equal runtime PASS; every admitted edge requires exact execution evidence before S2 closure."
  },
