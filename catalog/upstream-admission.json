{
  "apiVersion": "platform.4so.io/v1alpha1",
  "kind": "CatalogUpstreamAdmission",
  "metadata": {
    "name": "enterprise-private-cloud-upstream-admission"
  },
  "spec": {
    "components": [
      {
        "catalogConstraint": "0.13.x",
        "chart": "capsule",
        "component": "capsule",
        "licenseSPDX": "Apache-2.0",
        "rationale": "Exact upstream-supported 0.13 chart selected; OCI content digest must be verified by acquisition tooling.",
        "selectedVersion": "0.13.11",
        "source": "oci://ghcr.io/projectcapsule/charts/capsule",
        "status": "ready-for-acquisition",
        "runtimeStatus": "eligible-after-source-resolution",
        "upstreamVersion": "0.13.11"
      },
      {
        "catalogConstraint": "18.12.x",
        "chart": "loki",
        "component": "loki",
        "licenseSPDX": "Apache-2.0",
        "valuesFiles": [
          "runtime/catalog-values/loki-source-render.yaml"
        ],
        "rationale": "OSS Loki Helm ownership moved to grafana-community/helm-charts and the maintained community chart uses a new major chart line. Exact chart 18.12.1 is admitted from the new official community repository; immutable source acquisition and runtime certification remain separate.",
        "reviewEvidence": [
          {
            "kind": "source-migration",
            "url": "https://github.com/grafana/helm-charts/issues/4087",
            "summary": "Grafana moved the OSS Loki chart to grafana-community/helm-charts in 2026."
          },
          {
            "kind": "release",
            "url": "https://github.com/grafana-community/helm-charts/blob/main/charts/loki/Chart.yaml",
            "summary": "The maintained community Loki Chart.yaml publishes exact chart 18.12.1."
          }
        ],
        "selectedVersion": "18.12.1",
        "source": "https://grafana-community.github.io/helm-charts",
        "status": "ready-for-acquisition",
        "runtimeStatus": "eligible-after-source-resolution",
        "upstreamVersion": "18.12.1"
      },
      {
        "catalogConstraint": "0.16.x",
        "chart": "metallb",
        "component": "metallb",
        "licenseSPDX": "Apache-2.0",
        "rationale": "Exact MetalLB 0.16.1 source may be immutably acquired for inspection/evidence. Runtime certification remains blocked by the documented grpc/CVE concern until a safe released candidate is selected or the risk is explicitly dispositioned; source acquisition does not certify the image set.",
        "reviewEvidence": [
          {
            "kind": "release",
            "url": "https://github.com/metallb/metallb/actions/workflows/publish.yaml",
            "summary": "Official publish workflow shows the v0.16.1 release line."
          },
          {
            "kind": "blocker",
            "url": "https://github.com/metallb/metallb/issues/3113",
            "summary": "Open upstream request states v0.16.1 predates the grpc bump fixing CVE-2026-33186 and no released tag carries the fix yet."
          }
        ],
        "selectedVersion": "0.16.1",
        "source": "https://metallb.github.io/metallb",
        "status": "ready-for-acquisition",
        "runtimeStatus": "review-required",
        "upstreamVersion": "0.16.1"
      },
      {
        "catalogConstraint": "0.90.x",
        "chart": "victoria-metrics-k8s-stack",
        "component": "victoria-metrics",
        "licenseSPDX": "Apache-2.0",
        "rationale": "Exact current official 0.90-series chart is inside the shipped catalog constraint; acquisition must still verify upstream digest, immutable render and image provenance.",
        "selectedVersion": "0.90.2",
        "source": "https://victoriametrics.github.io/helm-charts/",
        "status": "ready-for-acquisition",
        "runtimeStatus": "eligible-after-source-resolution",
        "upstreamVersion": "0.90.2"
      }
    ],
    "policy": {
      "allowLatestResolution": false,
      "autoWidenCatalogConstraint": false,
      "runtimeCertification": "separate-runtime-evidence-required",
      "candidateAcquisition": "exact-source-may-be-acquired-before-runtime-clearance",
      "sourceAuthority": "official-upstream-only",
      "sourceResolution": "separate-immutable-acquisition-required",
      "versionSelection": "exact-semver-no-prerelease"
    }
  }
}
