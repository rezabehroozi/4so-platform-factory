{
  "apiVersion": "platform.4so.io/v1alpha1",
  "kind": "PlatformComponent",
  "metadata": {
    "name": "grafana"
  },
  "spec": {
    "capabilities": [
      "dashboards"
    ],
    "category": "observability",
    "certification": {
      "evidenceDigest": "",
      "profiles": [],
      "status": "candidate"
    },
    "compatibility": {
      "architectures": [
        "amd64",
        "arm64"
      ],
      "distributionProfiles": [
        "kubernetes",
        "rke2"
      ],
      "kubernetes": {
        "maxVersion": "1.35",
        "minVersion": "1.34"
      },
      "providers": [
        "imported",
        "cluster-api-topology-v1beta2"
      ]
    },
    "conflictsWith": [],
    "delivery": {
      "chart": "grafana",
      "repositoryKey": "platform-charts",
      "type": "helm"
    },
    "dependencies": [
      "victoria-metrics",
      "loki"
    ],
    "displayName": "Grafana",
    "evidenceRequired": [
      "resolved-source-lock",
      "rendered-resource-inventory",
      "policy-result",
      "runtime-readiness",
      "rollback-verification"
    ],
    "exclusiveCapabilities": [],
    "mandatory": true,
    "namespace": "monitoring",
    "operations": {
      "install": "required",
      "preflight": "required",
      "rollback": "required",
      "uninstall": "safe-when-supported",
      "upgrade": "required",
      "verify": "required"
    },
    "provides": [
      "dashboard-ui"
    ],
    "readiness": [
      "deployment/grafana"
    ],
    "release": "12.10.x",
    "requiresCapabilities": [
      "metrics-backend",
      "logs-backend"
    ],
    "risk": "medium",
    "rollback": {
      "strategy": "restore-previous-release-and-database-backup"
    },
    "settingsSchemaRef": "schemas/settings/grafana.schema.json",
    "source": {
      "artifactDigest": "",
      "imageInventoryDigest": "",
      "licenseManifestDigest": "",
      "provenance": "required",
      "resolved": false,
      "sbom": "required",
      "signatureVerification": "required",
      "sourceLockDigest": "",
      "type": "helm-chart"
    },
    "supportTier": "research-candidate",
    "versionPolicy": "resolve-verify-and-pin-before-execution",
    "wave": 70
  }
