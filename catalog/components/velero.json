{
  "apiVersion": "platform.4so.io/v1alpha1",
  "kind": "PlatformComponent",
  "metadata": {
    "name": "velero"
  },
  "spec": {
    "capabilities": [
      "backup",
      "restore"
    ],
    "category": "resilience",
    "certification": {
      "evidenceDigest": "",
      "profiles": [],
      "status": "candidate"
    },
    "compatibility": {
      "architectures": [
        "amd64",
        "arm64"
      ],
      "distributionProfiles": [
        "kubernetes",
        "rke2"
      ],
      "kubernetes": {
        "maxVersion": "1.35",
        "minVersion": "1.34"
      },
      "providers": [
        "imported",
        "cluster-api-topology-v1beta2"
      ]
    },
    "conflictsWith": [],
